{
  "name": "vscode-audio-browser",
  "displayName": "Audio Browser",
  "description": "Open local audio files in VS Code with an inline player custom editor.",
  "version": "0.1.0",
  "publisher": "mandipgosal",
  "author": {
    "name": "Mandip Gosal"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgosal/vscode-audio-browser.git"
  },
  "bugs": {
    "url": "https://github.com/mgosal/vscode-audio-browser/issues"
  },
  "homepage": "https://github.com/mgosal/vscode-audio-browser#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "audio",
    "player",
    "m4a",
    "mp3",
    "wav",
    "ogg",
    "flac",
    "music",
    "voice-notes",
    "custom-editor"
  ],
  "activationEvents": [
    "onCustomEditor:audioBrowser.player"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "audioBrowser.player",
        "displayName": "Audio Player",
        "selector": [
          { "filenamePattern": "*.m4a" },
          { "filenamePattern": "*.mp3" },
          { "filenamePattern": "*.wav" },
          { "filenamePattern": "*.ogg" },
          { "filenamePattern": "*.flac" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --minify"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.3.0"
  }
}
